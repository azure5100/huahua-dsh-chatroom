{
  "name": "dsh-weave",
  "version": "0.1.0-rc.14",
  "description": "A private, peer-to-peer weave protocol for connecting DeepSeek Harness nodes across machines.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/",
    "docs/ADR-001-authoritative-chat-rooms.md",
    "docs/ARCHITECTURE.md",
    "docs/PROTOCOL.md",
    "docs/SECURITY.md",
    "README.md",
    "README.zh.md",
    "RELEASES.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && npm test && npm pack --dry-run",
    "test": "node --test test/**/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "mesh",
    "iroh",
    "p2p",
    "quic"
  ],
  "author": "Xiang Bai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baixianger/dsh-weave.git"
  },
  "bugs": {
    "url": "https://github.com/baixianger/dsh-weave/issues"
  },
  "homepage": "https://github.com/baixianger/dsh-weave#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@number0/iroh": "^1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  }
}
